# Copy to .env (git-ignored) and fill in what you use. Everything is optional.

# Login. Leave unset only for a quick LAN test.
JARVIS_PASSWORD=change-me

# Phone push for "Needs attention" alerts (https://ntfy.sh — use a long, secret topic).
# NTFY_URL=https://ntfy.sh/your-long-secret-topic
# NTFY_TOKEN=

# AdGuard Home panel.
# ADGUARD_URL=http://host.docker.internal:3001
# ADGUARD_USER=
# ADGUARD_PASSWORD=

# Assistant. Shown by default (each browser can toggle it in the header); set 0 to hide by default.
# ASSISTANT_ENABLED=1
# ASSISTANT_NAME=Cubert
# Point at any OpenAI-compatible server (Ollama, llama.cpp, LM Studio...). Unset = preview mode.
# ASSISTANT_URL=http://host.docker.internal:11434/v1
# ASSISTANT_MODEL=llama3.1:8b
# ASSISTANT_API_KEY=

# Extra links for services Helm can't detect: name=url, comma-separated
# (name = container name or compose project). A container label helm.url=... also works.
# SERVICE_URLS=jellyfin=https://jellyfin.example.com
