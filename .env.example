# Optional — Helm is configured from its Settings page. Anything set here is
# used as a default (the Settings page wins once you save there).

# Port Helm listens on (the installer sets this).
# HELM_PORT=8787

# Your user id, so files the file manager creates belong to you (the installer sets this).
# PUID=1000

# Use a fixed password from here instead of the one created in the browser.
# JARVIS_PASSWORD=

# Advanced defaults (all editable in Settings): DRIVES, FILE_ROOTS, WUD_URL,
# ADGUARD_URL / ADGUARD_USER / ADGUARD_PASSWORD, NPM_DATA_DIR, NTFY_URL / NTFY_TOKEN,
# BACKUP_STATUS / BACKUP_COMMAND / BACKUP_DIR, NET_IFACE, SERVICE_URLS,
# ASSISTANT_ENABLED / ASSISTANT_NAME / ASSISTANT_URL / ASSISTANT_MODEL / ASSISTANT_API_KEY
